# The app's origin, used by every "Get started" and "Log in" link.
#
# Unset, the landing page points at the app's dev server (localhost:5173), so
# running both with `pnpm dev` works with no env file. Set this on the landing
# deployment — Vite inlines it at build time, so it needs a redeploy to apply.
#
# Target is https://studio.blomstr.app ("studio", not "app", since the TLD is
# already .app). Until that domain is live, use the app site's netlify.app URL.
VITE_APP_URL=https://studio.blomstr.app

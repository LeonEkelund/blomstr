# Anon key only — safe to ship, every table is guarded by RLS.
# Never put the service-role key in a client app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Browser-visible by design. Restrict this key to the Picker API and site origins.
VITE_GOOGLE_PICKER_API_KEY=
# The numeric Google Cloud project number, not its project ID.
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=
